# ILMATRIX Environment Configuration

# Server Configuration
PORT=8787
HOST=localhost
NODE_ENV=development

# Groq AI Configuration
GROQ_API_KEY=your_groq_api_key_here
# Primary text model. Llama 4 Maverick was retired by Groq on 2026-03-09.
GROQ_MODEL=openai/gpt-oss-120b
# Used automatically on rate limits, outages or a decommissioned primary model (empty disables)
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
# gpt-oss is text-only. Images (OCR, image questions) use this model.
# qwen/qwen3.8-27b is a Preview model on Groq and may change; empty disables vision.
GROQ_VISION_MODEL=qwen/qwen3.8-27b
# Reasoning effort for free-form answers: low | medium | high (JSON tools always use low)
GROQ_REASONING_EFFORT=medium
# Strict JSON-schema outputs for quiz/flashcard/dialogue tools
GROQ_STRUCTURED_OUTPUTS=true
GROQ_CONCURRENCY=4
GROQ_TIMEOUT_MS=45000

# Material Configuration
# Max characters from uploaded materials to include in prompts (to avoid truncating multi-file content)
# Default in code is 100000; override here if needed (e.g., 200000). Keep within your provider token limits.
MATERIAL_CLAMP=200000
# Guest materials are deleted this long after their last use
MATERIAL_TTL_MINUTES=60
# Signed-in users' materials are kept this long after their last use (saved ones: until deleted)
MATERIAL_USER_RETENTION_DAYS=180
# Max extracted text stored per signed-in user
MATERIAL_USER_QUOTA_MB=200

# Kredit (cost-weighted usage unit, 1 kredit ~ Rp4 of AI cost). Free plan allowance per week;
# paid plans and products are defined in src/config/plans.ts
KREDIT_FREE_WEEKLY=150

# Rate Limiting
RATE_LIMIT_MAX=120
# AI endpoints, per user (guests: per device). Sliding windows plus requests in flight;
# kredit limits spend, these keep one client from flooding the shared Groq queue
AI_RATE_LIMIT_PER_MINUTE=12
AI_RATE_LIMIT_PER_HOUR=150
AI_MAX_CONCURRENT=2

# Client IP: which header holds the real client IP. Only trust a header your proxy overwrites.
#   x-real-ip (default; Railway's edge sets it), cf-connecting-ip (site proxied through Cloudflare),
#   x-forwarded-for (uses the rightmost entry), none (direct connections / local development)
# Check after deploying: GET /api/admin/client-ip (admin) shows the IP the server sees
CLIENT_IP_HEADER=x-real-ip

# Guest bot protection (Cloudflare Turnstile, https://dash.cloudflare.com/?to=/:account/turnstile).
# Without both keys guests are limited only by the per-IP caps below.
# Test keys that always pass: site 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Per-IP daily guest caps. Generous because campus Wi-Fi and mobile CGNAT put many students on one IP
GUEST_IP_DAILY_VERIFICATIONS=20
GUEST_IP_DAILY_REQUESTS=100

# File Processing
PDF_MAX_PAGES=200

# Database Configuration (Railway PostgreSQL)
# Production: Railway provides DATABASE_URL automatically via private network (recommended)
# Development: Use DATABASE_LOCAL_URL for local development with public network access
DATABASE_URL=                          # Auto-provided by Railway in production (private network)
DATABASE_LOCAL_URL=postgresql://username:password@host:port/database  # For local development
# Database SSL override (default: on in production). npm runs scripts with NODE_ENV=production
# because .npmrc sets omit=dev, so set false for a local Postgres without SSL.
# DATABASE_SSL=false
# Run after every deploy that adds a migration: npm run migrate run

# Email Configuration (Resend)
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_xxx
EMAIL_FROM_ADDRESS=noreply@yourdomain.com
BASE_URL=http://localhost:8787

# Google OAuth Configuration
# Get these from Google Cloud Console: https://console.cloud.google.com/
# 1. Create a new project or select existing
# 2. Enable Google+ API
# 3. Create OAuth 2.0 credentials
# 4. Add your domain to authorized origins
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
# For local development, use http://localhost:8787/api/auth/google/callback
# For production, use https://ilmatrix.tech/api/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:8787/api/auth/google/callback

# Payments (Midtrans Snap). Payments are off until MIDTRANS_SERVER_KEY is set.
# Keys: Midtrans Dashboard > Settings > Access Keys. Sandbox keys start with "SB-".
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false
# Optional: payment methods to offer, comma-separated (default: everything active on your account),
# e.g. other_qris,gopay,shopeepay,bank_transfer
MIDTRANS_ENABLED_PAYMENTS=
# Optional: webhook URL sent with each transaction (X-Override-Notification). Defaults to
# ${BASE_URL}/api/payments/midtrans/notification when BASE_URL is https; otherwise set the
# Notification URL in the Midtrans dashboard (Settings > Payment > Notification URL).
MIDTRANS_NOTIFICATION_URL=

# Development only - remove in production
# DISABLE_AUTH=true